{
  "name": "cpp-snapshot-backup",
  "displayName": "C++ Snapshot Backup",
  "description": "Durable per-save C++ snapshots and serialized GitHub publishing for this project.",
  "version": "1.1.0",
  "publisher": "local-cpp-tools",
  "engines": {"vscode": "^1.90.0"},
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished", "onLanguage:cpp"],
  "main": "./extension.js",
  "capabilities": {"untrustedWorkspaces": {"supported": false}},
  "contributes": {"commands": [
    {"command": "cppBackup.upload", "title": "C++ Backup: Save and Upload Snapshot"},
    {"command": "cppBackup.retry", "title": "C++ Backup: Retry Publishing"},
    {"command": "cppBackup.showLog", "title": "C++ Backup: Show Log"}
  ]}
}
